manifest {
    name = 'nf-abricate'
    description = 'Contig-level Prodigal, ABRicate and ISEScan screening with feature-context integration'
    mainScript = 'main.nf'
    nextflowVersion = '>=25.10.0'
}

params {
    input = null
    resfinder_fasta = null
    vfdb_fasta = null
    outdir = 'results'
    min_identity = 90
    min_coverage = 80
    max_pair_distance = 10000
}

workflow.output.mode = 'copy'
outputDir = params.outdir

process {
    cpus = 1
    errorStrategy = { task.exitStatus in [130, 137, 143] ? 'retry' : 'terminate' }
    maxRetries = 2
}

profiles {
    local {
        process.executor = 'local'
    }
    docker {
        docker.enabled = true
        process.executor = 'local'
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        process.executor = 'local'
    }
}
